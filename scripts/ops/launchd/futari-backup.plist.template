<?xml version="1.0" encoding="UTF-8"?>
<!--
  #1549 — LaunchAgent for the daily prod backup, at 08:00 local time.
  Template only: scripts/ops/install-backup.sh fills in the two placeholders with
  paths under your home directory and writes the result to
  ~/Library/LaunchAgents/. It does not load it; loading is the owner's step
  (ops-runbook §「Prod backup (futari_backup)」).

  Umask 63 = 077: launchd creates the stdout/stderr files mode 600.
  If the Mac is asleep at 08:00, launchd runs the job at the next wake.
  Why 08:00 and not the small hours: a failure notification raised while a
  Sleep focus is on goes silently to Notification Center, so a 03:30 failure
  went unseen; at 08:00 the owner is awake and the Mac is usually on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.futari.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUN_SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>Umask</key>
  <integer>63</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LAUNCHD_LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LAUNCHD_LOG__</string>
</dict>
</plist>
